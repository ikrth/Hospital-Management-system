{
  "name": "hospital-ms-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node scripts/seed.js",
    "db:backup": "node scripts/db/rollback.js backup",
    "db:list": "node scripts/db/rollback.js list",
    "db:rollback": "node scripts/db/rollback.js rollback",
    "db:clear": "node scripts/db/rollback.js clear",
    "db:reseed": "node scripts/db/rollback.js reseed",
    "setup:path": "powershell -ExecutionPolicy Bypass -File scripts/setup/addMongoToPath.ps1",
    "test": "jest --detectOpenHandles"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.0.3",
    "express": "^4.18.2",
    "express-validator": "^6.14.3",
    "groq-sdk": "^1.1.2",
    "helmet": "^6.0.1",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.3.1",
    "morgan": "^1.10.0",
    "nodemailer": "^8.0.7",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "jest": "^29.5.0",
    "mongodb-memory-server": "^9.1.8",
    "nodemon": "^2.0.22",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node"
  }
}
